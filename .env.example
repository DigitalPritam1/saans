# Environment variables for Saans
PORT=8080
NODE_ENV=development

# Google Gemini API Key (Required for /api/plan and /api/chat)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Google Maps / Air Quality API Key (Server-side key for Google Air Quality API)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Maps Browser Key (Optional: restricted key for Maps JS / Places if different from server key)
GOOGLE_MAPS_BROWSER_KEY=your_restricted_browser_maps_key_here
